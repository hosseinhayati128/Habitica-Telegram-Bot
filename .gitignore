# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and build output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Local secrets and host-specific configuration
.env
.env.*
!.env.example
*.pem
*.key

# Pickle persistence contains Habitica credentials. Keep every copy private.
*.pkl
*.pickle
*.pkl.*
*.pickle.*
botdata.pkl.lock

# Runtime-generated avatar cache and temporary files
Avatar/
.runtime/
.avatar-*.tmp
user.json
avatar-*.json
*.tmp.json
*.tmp

# Node dependencies and logs
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# habitica-avatar.bundle.js is generated but intentionally tracked. Do not
# ignore or edit it by hand; rebuild it with `npm run build:avatar`.
!habitica-avatar.bundle.js
